# ──────────────────────────────────────────────────
# AbhiClaw Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────

# ── LLM Provider (Required) ──────────────────────
# OpenRouter API key — get one free at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to use via OpenRouter (leave blank for auto-routing)
# Examples: "deepseek/deepseek-v4-flash", "openrouter/auto"
OPENROUTER_MODEL=openrouter/auto

# ── Web Search (Optional) ────────────────────────
# Brave Search API key for the search_web tool
# Get one at https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# ── Web Scraping (Optional) ──────────────────────
# Firecrawl API key for the scrape_page tool
# Get one at https://firecrawl.dev/
FIRECRAWL_API_KEY=
